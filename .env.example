# Copy to .env (or export directly) for local development.
# Never commit a real .env file - see .gitignore.

APP_ENV=development
HTTP_ADDR=:8080

DATABASE_URL=postgres://igaming:igaming_dev_password@127.0.0.1:5432/igaming_platform_dev?sslmode=disable
DATABASE_MAX_CONNS=10

# Stage 1 foundation only - HMAC shared secret. Never reused across
# environments; production authentication is expected to replace this
# mechanism entirely (see docs/architecture/04-api-architecture.md).
JWT_SIGNING_SECRET=dev-only-secret-change-me-32-chars-min
JWT_ISSUER=igaming-platform

OTEL_SERVICE_NAME=platform-api
OTEL_EXPORTER=stdout

# A9 observability and alert delivery (docs/runbooks/alert-delivery-channels.md). Everything below is OFF unless set.
# Prometheus metrics on a DEDICATED listener (never the public API port). Production refuses a non-loopback bind
# unless METRICS_ALLOW_NON_LOOPBACK=true acknowledges network-level protection.
# METRICS_ADDR=127.0.0.1:9464
# Alert email recipients (comma-separated bare addresses; platform configuration, never route data). With the
# MOCK email provider (the only one today) an email alert reaches NO person.
# ALERT_EMAIL_RECIPIENTS=oncall@example.com
# One HMAC-signed webhook. The URL must be https (loopback http only under APP_ENV=development) and the secret is a
# secret-store REFERENCE, never the secret itself.
# ALERT_WEBHOOK_URL=https://hooks.example.com/alerts
# ALERT_WEBHOOK_SECRET_REF=devfile://alert-webhook?version=v1
# Resolved-alert retention (days, minimum 7). Unset = no purge job (history grows without bound).
# ALERT_RETENTION_DAYS=400
# ALERT_RETENTION_INTERVAL_HOURS=24

# Stage 10.3 W2a (ADR 0093 §2/A3): the provider-credential fingerprint HMAC
# key. This value is a PUBLISHED, dev-only placeholder - config.Load refuses
# it unless APP_ENV is explicitly "development". Leave it unset to run
# without the real provider-credential subsystem (fail closed).
PROVIDER_CREDENTIAL_FINGERPRINT_KEY=dev-only-provider-credential-fingerprint-key-not-a-secret
# Secret-store backends (comma-separated). "devfile" is development-only and
# reads SECRETSTORE_DEVFILE_ROOT (git- and docker-ignored, must be 0700).
# SECRETSTORE_BACKENDS=devfile
# SECRETSTORE_DEVFILE_ROOT=./.secrets/dev

# PRH-2 R5 (ADR 0110): signed actor proof for K2/K3 four-eyes writes. No
# committed value exists: generate a key (for example `openssl rand -base64 48`)
# and have the OWNER role insert the same secret into actor_proof_keys. Without
# these two variables governed K2/K3 writes fail closed at the database;
# production refuses to start without them.
# ACTOR_PROOF_KEYS=dev1:<base64 secret>
# ACTOR_PROOF_ACTIVE_KID=dev1

# ADR 0119: staff MFA key families (factor-secret AEAD; keyed MACs). REQUIRED in
# EVERY environment since S3: platform-api and cmd/seed-admin refuse to start
# without them (staffmfa.LoadKeys / VerifyStartup) - there is no staff login and no
# bypass without keys. The values below are PUBLISHED development placeholders,
# not secrets: config.Load refuses them unless APP_ENV is explicitly
# "development" (as above). Generate real keys per environment as described in
# docs/runbooks/staff-mfa-keys.md (never reuse a key across families or
# environments). After the S3 cutover (migration 0138) every staff member logs
# in with a second factor: see docs/runbooks/staff-mfa-s3-cutover.md.
STAFF_MFA_FACTOR_KEYS=dev1:ZGV2LW9ubHktc3RhZmYtbWZhLWZhY3Rvci1rZXktbm90LWEtc2VjcmV0LTAwMDE=
STAFF_MFA_FACTOR_ACTIVE_KID=dev1
STAFF_MFA_MAC_KEYS=dev1:ZGV2LW9ubHktc3RhZmYtbWZhLW1hYy1rZXktbm90LWEtc2VjcmV0LTAwMDAwMDAx
STAFF_MFA_MAC_ACTIVE_KID=dev1
