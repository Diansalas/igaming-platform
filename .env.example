# Copy to .env (or export directly) for local development.
# Never commit a real .env file - see .gitignore.

APP_ENV=development
HTTP_ADDR=:8080

DATABASE_URL=postgres://igaming:igaming_dev_password@127.0.0.1:5432/igaming_platform_dev?sslmode=disable
DATABASE_MAX_CONNS=10

# Stage 1 foundation only - HMAC shared secret. Never reused across
# environments; production authentication is expected to replace this
# mechanism entirely (see docs/architecture/04-api-architecture.md).
JWT_SIGNING_SECRET=dev-only-secret-change-me-32-chars-min
JWT_ISSUER=igaming-platform

OTEL_SERVICE_NAME=platform-api
OTEL_EXPORTER=stdout

# Stage 10.3 W2a (ADR 0093 §2/A3): the provider-credential fingerprint HMAC
# key. This value is a PUBLISHED, dev-only placeholder - config.Load refuses
# it unless APP_ENV is explicitly "development". Leave it unset to run
# without the real provider-credential subsystem (fail closed).
PROVIDER_CREDENTIAL_FINGERPRINT_KEY=dev-only-provider-credential-fingerprint-key-not-a-secret
# Secret-store backends (comma-separated). "devfile" is development-only and
# reads SECRETSTORE_DEVFILE_ROOT (git- and docker-ignored, must be 0700).
# SECRETSTORE_BACKENDS=devfile
# SECRETSTORE_DEVFILE_ROOT=./.secrets/dev

# PRH-2 R5 (ADR 0110): signed actor proof for K2/K3 four-eyes writes. No
# committed value exists: generate a key (for example `openssl rand -base64 48`)
# and have the OWNER role insert the same secret into actor_proof_keys. Without
# these two variables governed K2/K3 writes fail closed at the database;
# production refuses to start without them.
# ACTOR_PROOF_KEYS=dev1:<base64 secret>
# ACTOR_PROOF_ACTIVE_KID=dev1
