# Stage 5 Back Office - build/runtime configuration.
#
# This app calls the Platform API exclusively through `src/api/client.ts`,
# which is the ONLY module allowed to know an HTTP base URL. Nothing here
# is, or should ever become, a secret: staff authentication is a
# username/password exchange performed at runtime against the Platform
# API (src/api/auth.ts), never a build-time credential. Do NOT add an API
# key, client secret, or any other credential to this file or to any
# `VITE_*` variable - everything prefixed `VITE_` is inlined into the
# built JS bundle and is world-readable in the browser by Vite's own
# design, regardless of whether the file is committed.

# Optional: only needed if this app is NOT served same-origin with the
# Platform API in production (same-origin is the default and avoids
# needing this entirely - requests go to a relative `/v1/...` path).
# Required to be an absolute origin including scheme when set (e.g.
# "https://api.example.com"), never a path fragment - see API_BASE in
# src/api/client.ts.
# VITE_API_BASE_URL=https://api.example.com

# Dev-server only (ignored in a production build): overrides where the
# Vite dev-server proxy forwards /v1 requests to (see vite.config.ts).
# Defaults to http://localhost:8080.
# VITE_API_PROXY_TARGET=http://localhost:8080
