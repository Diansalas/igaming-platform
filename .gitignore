# Go
/bin/
*.exe
*.test
*.out

# Environment
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/

# OS
.DS_Store

# Terraform (ADR 0086) — state, plans, provider caches and local variable
# files must never be committed. Staging state lives in the remote S3
# backend; bootstrap state is local-only by design.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
*.tfplan.txt
plan.json
*.plan.json
tfplan
tfplan.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Reusable modules are not roots: only the root modules
# (deploy/aws/environments/*, deploy/aws/bootstrap) commit a lock file.
deploy/aws/modules/*/.terraform.lock.hcl
