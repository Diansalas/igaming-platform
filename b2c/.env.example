# Stage 6 B2C brand frontend - per-brand build configuration.
#
# A second brand deployment of this SAME codebase copies this file to
# `.env` (or `.env.production`) and changes only the values below - never
# the source code. `VITE_BRAND_SLUG` is not cosmetic: it is sent as
# `brand_slug` on every register/login call, which is how the Platform
# API resolves which tenant this visitor belongs to
# (internal/httpserver/auth_routes.go).

# REQUIRED in a production build (`vite build`) - there is no dev-only
# fallback once `import.meta.env.PROD` is true. A brand deployment that
# omits this would otherwise silently register/log in every visitor
# against the wrong tenant (see src/config/brand.ts).
VITE_BRAND_SLUG=demo-casino
VITE_BRAND_DISPLAY_NAME=Demo Casino
VITE_BRAND_PRIMARY_COLOR=#2563eb
VITE_BRAND_PRIMARY_COLOR_HOVER=#1d4ed8
VITE_BRAND_DEFAULT_ASSET=USD

# Optional: override where the dev-server proxy forwards /v1 requests to
# (see vite.config.ts). Defaults to http://localhost:8080.
# VITE_API_PROXY_TARGET=http://localhost:8080

# Optional: if this app is NOT served same-origin with the Platform API in
# production, set the API's absolute base URL here.
# VITE_API_BASE_URL=https://api.example.com
