// CloudFront Function (cloudfront-js-2.0), viewer-request, rendered by
// Terraform from deploy/aws/modules/edge. STAGING ACCESS CONTROL (ADR 0086):
// only viewers whose IPv4 source address falls inside one of the allowed
// CIDRs below reach the origin; everyone else gets 403 before any request
// is forwarded. The distributions are IPv4-only (is_ipv6_enabled = false),
// and anything that does not parse as an IPv4 address fails closed (403).
//
// Plain ES5 on purpose; tested by deploy/aws/tests/edge-allowlist.test.mjs.
var ALLOWED_CIDRS = ${allowed_cidrs_json};

function ipv4ToNumber(ip) {
  var parts = String(ip).split('.');
  if (parts.length !== 4) {
    return -1;
  }
  var n = 0;
  for (var i = 0; i < 4; i++) {
    if (!/^[0-9]{1,3}$/.test(parts[i])) {
      return -1;
    }
    var octet = parseInt(parts[i], 10);
    if (octet > 255) {
      return -1;
    }
    n = n * 256 + octet;
  }
  return n;
}

// Arithmetic (not bitwise) prefix comparison: JS bitwise operators are
// signed 32-bit, which mishandles addresses >= 128.0.0.0.
function inCidr(ipNumber, cidr) {
  var slash = cidr.indexOf('/');
  if (slash < 0) {
    return false;
  }
  var base = ipv4ToNumber(cidr.substring(0, slash));
  var bits = parseInt(cidr.substring(slash + 1), 10);
  if (base < 0 || isNaN(bits) || bits < 0 || bits > 32) {
    return false;
  }
  var blockSize = Math.pow(2, 32 - bits);
  return Math.floor(ipNumber / blockSize) === Math.floor(base / blockSize);
}

function handler(event) {
  var ipNumber = ipv4ToNumber(event.viewer.ip);
  if (ipNumber >= 0) {
    for (var i = 0; i < ALLOWED_CIDRS.length; i++) {
      if (inCidr(ipNumber, ALLOWED_CIDRS[i])) {
        return event.request;
      }
    }
  }
  return {
    statusCode: 403,
    statusDescription: 'Forbidden'
  };
}
