# Copy to terraform.tfvars and edit. There are NO secrets to put in this
# file — Terraform generates every credential itself (random_password,
# stored in Secrets Manager). Everything below is non-secret sizing and
# identity configuration.

aws_region  = "eu-west-1"
name_prefix = "igaming-staging"

# --- Database sizing (staging defaults shown — safe to leave as-is) ---
# db_instance_class        = "db.t4g.micro"
# db_allocated_storage     = 20
# db_backup_retention_days = 7
# db_multi_az              = false
# db_deletion_protection   = false

# --- Image tag deploy/aws/scripts/deploy.sh pushed (commonly a git SHA) ---
# image_tag = "latest"

# --- Optional custom domain. Leave BOTH commented out for the plain-HTTP
#     ALB-DNS-name fallback (see the runbook). Supplying only one of the
#     two has no effect — both are required together. ---
# domain_name     = "staging.example.com"
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# --- Optional: subscribe an email address to the CloudWatch alarm SNS
#     topic. Staging does not require this. ---
# alarm_email = "oncall@example.com"

tags = {
  Owner = "devops"
}
