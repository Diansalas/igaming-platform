# Copy to terraform.tfvars (git-ignored) and edit. There are NO secrets to
# put in this file — every credential is generated by RDS or Terraform
# (ephemeral + write-only) and stored only in Secrets Manager (ADR 0086).

# Canonical staging region (ADR 0086). The variable is validated to this.
aws_region = "eu-central-1"

# REQUIRED. Who may reach the staging URLs through CloudFront; everyone else
# gets 403 at the edge. Replace the documentation-range placeholder below
# with your own public IPv4 address(es) as /32 (e.g. from
# `curl -4 https://checkip.amazonaws.com`), plus wherever the acceptance
# suite runs from. Prefixes shorter than /16 are rejected.
staging_access_cidrs = ["203.0.113.10/32"]

# image_tag is NOT set here: deploy/aws/scripts/deploy.sh always passes the
# full git commit SHA (-var image_tag=...). Mutable tags are rejected.

# --- Optional ---
# platform_api_desired_count = 1      # 2 only during the multi-replica test
# alarm_email                = "you@example.com"  # creates SNS topic + subscription
# ecs_public_ip_mode         = true   # false = production-shaped NAT layout (+~$0.057/h)

tags = {
  Owner = "devops"
}
